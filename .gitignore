.DS_Store

# Cocos Creator 编辑器生成目录
game/library/
game/temp/
game/local/
game/profiles/
game/native/
game/build/
game/.creator/

# Codex / 浏览器视觉回归产生的本地截图
.codex/
assets-3d/*.png
# v2 生成脚本先写候选目录，三角度通过后才提升到 Cocos resources；候选 GLB 可重复生成。
assets-3d/candidates/

# 第三方扫描源体积很大，只在本地保留官方下载原件；仓库提交署名、处理脚本和游戏中间件。
assets-3d/sources/**/source.zip
assets-3d/sources/**/original/scene.bin
assets-3d/sources/**/original/scene.gltf
assets-3d/processed/**/guardian-lion-game.glb

# Tripo 原始高模（15MB+，保留本地作源文件，不进仓库）
assets-3d/*3d model.glb

# 解压产物
game-demo/ximalaya/
game-demo/__MACOSX/

# 本地视觉验证截图 / Playwright 产物
.playwright-mcp/
shot-*.png
# QA 对比图同属本地产物：单张常有 1~3MB，早期漏了这条规则，已入库的那批用
# git rm --cached 移出（文件仍留在工作区）。
qa-*.png

# 模型统一视角审计的逐件帧与迭代目录；只提交 final 下体积较小的主题 JPG 表。
audit/model-quality/current/
audit/model-quality/after/
audit/model-quality/before/
audit/model-quality/frog-duck-v*/
audit/model-quality/final/*.png
audit/runtime/
# 单件重建过程中会产生多轮候选图；只提交葫芦 canonical v2 与玉玺 before/final 证据。
audit/model-quality/hulu-v3*/
audit/model-quality/yuxi-v2/after/
audit/model-quality/yuxi-v2/color-v*/
audit/model-quality/yuxi-v2/scan-candidate*/
audit/model-quality/yuxi-v2/source-*/

# Python 工具（scripts/*.py）的 lint 缓存。会生成在运行目录下，
# 包括 game/assets/ 内部——那是 Cocos 的资源扫描范围，别让它进去。
.ruff_cache/
scripts/__pycache__/
